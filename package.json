{
    "name": "entelechy-architect",
    "private": true,
    "scripts": {
        "build:architect": "npm run build:architect:css && npm run build:architect:js",
        "watch:architect": "npx tailwindcss -i ./resources/css/architect.css -o ./resources/dist/architect.css --watch",
        "build:architect:css": "npx tailwindcss -i ./resources/css/architect.css -o ./resources/dist/architect.css --minify",
        "build:architect:js": "vite build"
    },
    "dependencies": {
        "apexcharts": "^5.14.0",
        "flatpickr": "^4.6.13"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5",
        "@tailwindcss/typography": "^0.5",
        "autoprefixer": "^10.4",
        "tailwindcss": "^3.4",
        "vite": "^6.0"
    }
}
