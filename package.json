{
    "name": "entelechy-architect",
    "private": true,
    "scripts": {
        "build:architect": "npm run build:architect:css && npm run build:architect:js",
        "watch:architect": "npx tailwindcss -i ./resources/css/architect.css -o ./resources/dist/architect.css --watch",
        "build:architect:css": "npx tailwindcss -i ./resources/css/architect.css -o ./resources/dist/architect.css --minify && sed -i '' 's|url(\\.\\./webfonts/|url(webfonts/|g' ./resources/dist/architect.css && mkdir -p ./resources/dist/webfonts && cp ./node_modules/@fortawesome/fontawesome-free/webfonts/*.woff2 ./resources/dist/webfonts/",
        "build:architect:js": "vite build"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.0",
        "apexcharts": "^5.14.0",
        "cron-parser": "^5.7.0",
        "cropperjs": "^1.6.2",
        "flatpickr": "^4.6.13",
        "sortablejs": "^1.15.7",
        "tributejs": "^5.1.3"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5",
        "@tailwindcss/typography": "^0.5",
        "autoprefixer": "^10.4",
        "tailwindcss": "^3.4",
        "vite": "^6.0"
    }
}
